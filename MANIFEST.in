include README.md
include LICENSE
include pyproject.toml
include setup.py

recursive-include src *.py *.pyx

prune .venv
prune .git
prune .cursor
prune archive
prune build
prune dist
prune tests
prune phynetpy.egg-info

prune DEFJ
prune Guides
prune NexusFiles
prune docs
prune examples
prune scripts
prune paper
prune paper_figures
prune runs

global-exclude *.pyc
global-exclude __pycache__
global-exclude *.so
global-exclude *.c
