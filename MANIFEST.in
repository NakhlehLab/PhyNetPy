include README.md
include CHANGELOG.md
include RELEASE_NOTES_*.md
include LICENSE
include pyproject.toml
include setup.py

exclude deploy.py
exclude generate_docs.py
exclude reticulation_distance_report.pdf

recursive-include src *.py *.pyx

prune .venv
prune .git
prune .cursor
prune archive
prune build
prune dist
prune tests
prune phynetpy.egg-info

prune DEFJ
prune Guides
prune NexusFiles
prune docs
prune examples
prune scripts
prune paper
prune paper_figures
prune reports
prune runs
prune src/Theory

global-exclude *.pyc
global-exclude __pycache__
global-exclude *.so
global-exclude *.c
